# API keys for different providers
NVIDIA_API_KEY=your_nvidia_api_key_here
# COMPATIBLE_API_KEY=your_openai_compatible_key_here
# COMPATIBLE_BASE_URL=https://api.openai.com/v1
# COMPATIBLE_MODEL=gpt-4o

# Storage configuration
HF_STORAGE_BUCKET_NAME=your_bucket_name_here
STORAGE_BASE_PATH=/data

# LLM configuration
LLM_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-70b-instruct

# Server configuration
HOST=0.0.0.0
PORT=7860
LOG_LEVEL=WARNING

# Database configuration
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=sqlite.db

# Security
API_KEY_NAME=x-api-key
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload limits
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,docx,txt,md,csv,json,jpg,jpeg,png,webp

# HF specific
HF_SPACE_NAME=your_space_name_here